[run]
source = src
omit =
    */migrations/*
    */venv/*
    */env/*
    */virtualenv/*
    */.venv/*
    */tests/*
    */test_*.py
    */__pycache__/*
    */manage.py
    */settings/*
    */wsgi.py
    */asgi.py
    */conftest.py
    */setup.py
    */setup.cfg

[report]
exclude_lines =
    pragma: no cover
    def __repr__
    if self.debug:
    if settings.DEBUG
    raise AssertionError
    raise NotImplementedError
    if 0:
    if __name__ == .__main__.:
    class .*\bProtocol\):
    @(abc\.)?abstractmethod

[html]
directory = htmlcov
title = Document Search Coverage Report

[xml]
output = coverage.xml
